<Window x:Class="WindowTrace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowTrace" Height="780" Width="1180"
        MinHeight="600" MinWidth="900"
        Background="#F4F6FA"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="WindowTrace" FontSize="28" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="Windows foreground, CPU, ETW and frame diagnostics" Margin="0,3,0,0" Foreground="#64748B" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="2. Start monitoring" Click="StartButton_Click"
                        Padding="16,9" Margin="0,0,8,0" Background="#2868C7" Foreground="White" BorderThickness="0" />
                <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click"
                        Padding="16,9" Margin="0,0,8,0" IsEnabled="False" />
                <Button x:Name="ExportButton" Content="Export last session CSV" Click="ExportButton_Click"
                        Padding="16,9" Margin="0,0,8,0" />
                <Button x:Name="OpenReportButton" Content="Open last report" Click="OpenReportButton_Click"
                        Padding="16,9" IsEnabled="False" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Monitoring status" Foreground="#64748B" FontSize="12" />
                    <TextBlock x:Name="StatusText" Text="Not monitoring" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="CurrentWindowText" Text="Waiting for monitoring to start" Foreground="#475569" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Events observed" Foreground="#64748B" HorizontalAlignment="Right" />
                    <TextBlock x:Name="EventCountText" Text="0" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Target game process" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock x:Name="TargetText" Text="Step 1: Select the game window from the running-window list. Then start monitoring."
                           Foreground="#64748B" Margin="0,4,0,10" TextWrapping="Wrap" />
                <WrapPanel VerticalAlignment="Center">
                    <Button x:Name="SetTargetButton" Content="1. Select game window"
                            Click="SetTargetButton_Click" Padding="12,7" Margin="0,0,8,8" />
                    <Button x:Name="ClearTargetButton" Content="Clear selection"
                            Click="ClearTargetButton_Click" Padding="12,7" Margin="0,0,8,8" />
                    <TextBox x:Name="PresentMonPathText" Width="300" Height="30" Margin="0,0,8,8"
                             VerticalContentAlignment="Center" ToolTip="Path to PresentMon.exe (optional)" />
                    <Button Content="Browse PresentMon.exe" Click="BrowsePresentMonButton_Click"
                            Padding="12,7" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel Margin="0,2,0,0">
                    <CheckBox x:Name="InputMarkerCheckBox" Content="Enable explicit test marker: Ctrl+Alt+F12"
                              IsChecked="False" Checked="InputMarkerCheckBox_Checked"
                              Unchecked="InputMarkerCheckBox_Unchecked" Margin="0,0,12,4" />
                </WrapPanel>
                <TextBlock Text="Workflow: 1) Select the game window. 2) Start monitoring. 3) Wait until the status says Ready to reproduce (the app fills the 3-second pre-capture buffer automatically). 4) Alt+Tab away and return to the game. After return, capture ends when CPU plus GPU or PresentMon evidence is available after at least 1.5 seconds; hard maximum is 3 seconds. Missing collector data is reported as unavailable, not zero. PresentMon 2.x is optional. The Ctrl+Alt+F12 marker is optional, consumed by WindowTrace, and records timestamps only—not key contents."
                           Foreground="#64748B" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#EEF4FF" BorderBrush="#D5E3FA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <TextBlock x:Name="EnvironmentText" Foreground="#334155" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10">
            <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" Background="White" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="UTC time" Binding="{Binding UtcTimestamp, StringFormat={}{0:HH:mm:ss.fff}}" Width="145" />
                    <DataGridTextColumn Header="Relative (ms)" Binding="{Binding RelativeMilliseconds, StringFormat={}{0:F3}}" Width="115" />
                    <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="150" />
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="150" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="5" x:Name="FooterText" Margin="2,10,2,0" Foreground="#64748B"
                   Text="No keyboard contents are collected. ETW kernel events may require administrator privileges; no automatic elevation is performed."
                   TextWrapping="Wrap" />
    </Grid>
</Window>
